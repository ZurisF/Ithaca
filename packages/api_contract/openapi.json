            "minLength": 1,
            "title": "Operation Name"
          },
          "provider": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Model"
          },
          "prompt_version": {
            "anyOf": [
              {
