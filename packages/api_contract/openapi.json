  "components": {
    "schemas": {
      "Direction": {
        "type": "string",
        "enum": [
          "project_overview",
          "core_flow_deep_dive",
          "cross_cutting",
          "stress_interview",
          "contribution_retrospective"
        ],
        "title": "Direction"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InterviewPlan": {
        "properties": {
          "stages": {
            "items": {
              "$ref": "#/components/schemas/InterviewStage"
            },
            "type": "array",
            "title": "Stages"
          },
          "template_id": {
            "type": "string",
            "title": "Template Id"
          },
          "template_version": {
            "type": "string",
            "title": "Template Version"
          },
          "topic_registry_version": {
            "type": "string",
            "title": "Topic Registry Version"
          },
          "planning_policy_version": {
            "type": "string",
            "title": "Planning Policy Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stages",
          "template_id",
          "template_version",
          "topic_registry_version",
          "planning_policy_version"
        ],
        "title": "InterviewPlan"
      },
      "InterviewStage": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "goal": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Goal"
          },
          "complete_when": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Complete When"
          },
          "topic_path": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Topic Path"
          },
          "section_refs": {
            "items": {
              "$ref": "#/components/schemas/SectionRef"
            },
            "type": "array",
            "title": "Section Refs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "complete_when",
          "topic_path",
          "section_refs"
        ],
        "title": "InterviewStage"
      },
      "ModelTraceRequest": {
        "properties": {
          "trace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Trace Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
