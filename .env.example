# Copy to .env. Development values only; replace all passwords and tokens outside local use.
APP_DATABASE_URL=postgresql+asyncpg://interview:interview_dev_only@127.0.0.1:5432/interview_lab
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_LOCAL_RUNTIME_URL=http://127.0.0.1:8101
APP_DESKTOP_INSTANCE_TOKEN=replace-with-random-local-token
APP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_DEV_AUTH_ENABLED=true
APP_MODEL_API_KEY=
APP_MODEL_NAME=
APP_MODEL_BASE_URL=https://api.openai.com/v1
APP_MODEL_PROVIDER=openai_compatible
APP_MODEL_TIMEOUT_SECONDS=45
APP_POST_MODEL_TIMEOUT_SECONDS=180
# Shared by Application HTTP timeout and Local Runtime project-answer model steps.
APP_LOCAL_TASK_DEADLINE_SECONDS=180
APP_MODEL_MAX_ATTEMPTS=2
APP_MODEL_MAX_CONCURRENCY=4
APP_RETRIEVAL_LIMIT=3
APP_EMBEDDING_MODEL_PATH=BAAI/bge-m3
APP_RERANKER_MODEL_PATH=BAAI/bge-reranker-base
APP_RETRIEVAL_MIN_SCORE=0.1
APP_RETRIEVAL_TIMEOUT_SECONDS=30
APP_RETRIEVAL_MAX_ATTEMPTS=2
LOCAL_DESKTOP_INSTANCE_TOKEN=replace-with-random-local-token
LOCAL_BIND_HOST=127.0.0.1
LOCAL_BIND_PORT=8101
LOCAL_MODEL_MAX_CONCURRENCY=4
NEXT_PUBLIC_APPLICATION_URL=http://127.0.0.1:8100
